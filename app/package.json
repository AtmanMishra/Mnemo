{
  "name": "@selfev/mnemo-app",
  "version": "0.1.0",
  "description": "Mnemo: a terminal coding agent built on pi, with an Ink interface, a Rust memory layer and a Python execution kernel.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "start": "bun bin/mnemo.ts",
    "demo": "bun bin/mnemo.ts --demo",
    "test": "bun test --timeout 30000 ./test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@mnemo/memory": "workspace:*",
    "chalk": "6.0.0",
    "ink": "8.0.0",
    "marked": "18.1.0",
    "react": "19.3.0"
  },
  "bin": {
    "mnemo": "bin/mnemo.ts"
  },
  "license": "Apache-2.0",
  "author": "Atman Mishra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtmanMishra/Mnemo.git",
    "directory": "app"
  },
  "homepage": "https://github.com/AtmanMishra/Mnemo#readme",
  "bugs": "https://github.com/AtmanMishra/Mnemo/issues"
}
