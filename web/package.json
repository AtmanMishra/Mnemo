{
  "name": "@mnemo/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "node scripts/installers.mjs",
    "dev": "node scripts/installers.mjs && vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check.mjs",
