    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@lucasmarkes/hairline": "0.5.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
